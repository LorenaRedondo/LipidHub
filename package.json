{
  "name": "lipidex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LIPIDEX — an interactive atlas of the known & predicted lipidome",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:seo": "npm run build && tsx scripts/prerender-species.ts",
    "prerender": "tsx scripts/prerender-species.ts",
    "export:dataset": "tsx scripts/export-dataset.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate:smiles": "tsx scripts/validate-smiles.ts",
    "ingest:lmsd": "tsx scripts/ingest-lmsd.ts",
    "api": "tsx server/api.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.27",
    "openchemlib": "^9.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
