{
  "name": "lipidex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LIPIDEX — an interactive atlas of the known & predicted lipidome",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
